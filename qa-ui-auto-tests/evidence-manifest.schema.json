{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taomni.local/qa-ui-auto/evidence-manifest.schema.json",
  "title": "EditorEvidenceEntryV2",
  "description": "V0/W7 native gate evidence entry (§8.21.1). One entry per capability × platform under qa-ui-auto-report/evidence/<app-hash>/<platform>/",
  "type": "object",
  "required": [
    "schemaVersion",
    "capabilityId",
    "languageId",
    "app",
    "environment",
    "provider",
    "evidenceLayers",
    "result",
    "command",
    "artifacts",
    "knownGaps",
    "maximumClaim",
    "collectedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "languageId": { "type": ["string", "null"] },
    "app": {
      "type": "object",
      "required": ["commit", "bundleHash", "version"],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "bundleHash": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "required": ["platform", "os", "arch", "webview", "keyboard", "ime", "scale", "filesystem"],
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string", "enum": ["linux", "windows", "macos"] },
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "webview": { "type": "string" },
        "keyboard": { "type": "string", "description": "keyboard layout, e.g. us / de / cn,us" },
        "ime": { "type": "string" },
        "scale": { "type": "number", "description": "display scale, 1 = 100%, 2 = 200%" },
        "filesystem": { "type": "string" }
      }
    },
    "provider": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "version", "fixture"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "version": { "type": "string" },
            "fixture": { "type": "string" }
          }
        }
      ]
    },
    "evidenceLayers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["unit", "mounted", "browser", "native", "provider", "idea-compare"] }
    },
    "result": { "enum": ["passed", "failed", "blocked", "platform-unverified", "provider-unverified", "manual-native"] },
    "command": { "type": "string", "description": "exact command(s) executed" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256", "redacted"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "redacted": { "type": "boolean" }
        }
      }
    },
    "knownGaps": { "type": "array", "items": { "type": "string" } },
    "maximumClaim": { "enum": ["L0", "L1", "L2", "L3"], "description": "highest L0-L3 claim this single entry supports; never inferred across platforms" },
    "notes": { "type": "string" },
    "collectedAt": { "type": "string" }
  }
}
